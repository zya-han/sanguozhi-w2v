# Repo-local conda environment
.conda/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Large data & artifacts — 코퍼스별 디렉터리 data/<id>/… (provenance·시드 일부만 추적)
data/*/raw/
data/*/interim/
data/*/tokenized/
models/
# gazetteer.tsv 는 CC BY-NC-SA CBDB 파생물(최종 산출) → 재배포 금지(제외). Stage 3로 재생성.
# 큐레이션 입력(stoplist·variant_map·seed_supplement·user_dict)은 추적 — 사실 기반 개체 목록이라
# CBDB 재배포 우려와 무관하고, 모델 재현·LLM 분류 결과 보존을 위해 저장소에 둔다.
data/*/gazetteer/gazetteer.tsv
data/*/gazetteer/gazetteer_stats.json
# 웹 탐색기: 프런트엔드 소스(공통 app.js·style.css, 사서별 index.html·theme.css·og 이미지)는
# 추적. 추출물(데이터·단일 HTML)은 미추적(src/07·08로 재생성). 구조: web/<id>/{index,theme,data,번들}.
web/*/data/
web/*/*_explorer.html

# Cloned upstream sources
vendor/
*.sqlite
*.sqlite3

# OS
.DS_Store

# 핸드오프 명세서 (내부 문서, 미추적)
sanguozhi_word2vec_spec.md
docs/ADDING_A_CORPUS.md
docs/ADDING_AN_EXPLORER.md
docs/GAZETTEER_REFINEMENT.md

# 개인 튜토리얼 노트북 (배포 제외)
tutorial.ipynb

# 토큰화 감사 산출물 (scripts/audit_tokens.py로 재생성)
reports/*/audit_*.tsv
# LLM 전수분류 중간 산출물 (후보 덤프·적용 결과 — stoplist/seed에 이미 반영됨)
reports/*/llm_*.json
reports/*/llm_*.jsonl
